+/// Appends the seconds to the first "H:MM" in a formatted time, keeping any AM/PM suffix.
+func faithgramTimeWithSeconds(_ text: String, timestamp: Int32) -> String {
+    let seconds = String(format: "%02d", Int(((timestamp % 60) + 60) % 60))
+    guard let expression = try? NSRegularExpression(pattern: "\\d{1,2}:\\d{2}(?!:\\d)") else { return text }
+    guard let match = expression.firstMatch(in: text, range: NSRange(text.startIndex..., in: text)), let range = Range(match.range, in: text) else { return text }
+    return text.replacingCharacters(in: range, with: text[range] + ":" + seconds)
+}

@@ -0,0 +1,78 @@
+import Foundation
+import TelegramApi
+
+public enum FaithgramPrivacySettings {
+    public static let options: [PatchClientOption] = [.alwaysOffline, .blockCloudReads, .blockTyping, .localDrafts, .hideSelfPhone, .hideAds, .hideProxyPromo, .hidePinnedNotifications, .hideMentionNotifications, .cleanLinks, .hideAppPreview]
+    public static let profiles = ["standard", "quiet", "ghost", "custom"]
+    private static let defaults = UserDefaults.standard
+
+    private static func values(_ profile: String) -> [String: Bool]? {
+        if profile == "custom", let data = defaults.data(forKey: "faithgram.privacy.custom") { return try? JSONDecoder().decode([String: Bool].self, from: data) }
+        guard profiles.prefix(3).contains(profile) else { return nil }
+        let quiet: Set<PatchClientOption> = [.hideSelfPhone, .hideAds, .hideProxyPromo, .hidePinnedNotifications, .hideMentionNotifications, .cleanLinks, .hideAppPreview]
+        return Dictionary(uniqueKeysWithValues: options.map { option in
+            (option.rawValue, profile == "ghost" || (profile == "quiet" && quiet.contains(option)))
+        })
+    }
+    public static var currentProfile: String {
+        for name in profiles {
+            if let values = values(name), options.allSatisfy({ values[$0.rawValue] == PatchClientPolicy.isEnabled($0) }) { return name }
+        }
+        return "modified"
+    }
+    public static func saveCustomProfile() {
+        let value = Dictionary(uniqueKeysWithValues: options.map { ($0.rawValue, PatchClientPolicy.isEnabled($0)) })
+        defaults.set(try? JSONEncoder().encode(value), forKey: "faithgram.privacy.custom")
+        NotificationCenter.default.post(name: FaithgramPreferences.changed, object: nil)
+    }
+    @discardableResult public static func applyProfile(_ name: String) -> Bool {
+        guard let value = values(name), Set(value.keys) == Set(options.map { $0.rawValue }) else { return false }
+        let previous = Dictionary(uniqueKeysWithValues: options.map { ($0.rawValue, PatchClientPolicy.isEnabled($0)) })
+        defaults.set(try? JSONEncoder().encode(previous), forKey: "faithgram.privacy.previous")
+        for option in options { PatchClientPolicy.setEnabled(option, value[option.rawValue] == true) }
+        return true
+    }
+    public static func restorePreviousProfile() -> Bool {
+        guard let data = defaults.data(forKey: "faithgram.privacy.previous"), let values = try? JSONDecoder().decode([String: Bool].self, from: data), Set(values.keys) == Set(options.map { $0.rawValue }) else { return false }
+        for option in options { if let value = values[option.rawValue] { PatchClientPolicy.setEnabled(option, value) } }
+        defaults.removeObject(forKey: "faithgram.privacy.previous")
+        return true
+    }
+
+    public static func peerKey(namespace: Int32, id: Int64) -> String { return "\(namespace):\(id)" }
+    public static var ghostChats: Set<String> {
+        return Set(defaults.stringArray(forKey: "faithgram.privacy.ghostChats") ?? [])
+    }
+    public static func isGhostChat(namespace: Int32, id: Int64) -> Bool { return ghostChats.contains(peerKey(namespace: namespace, id: id)) }
+    public static func setGhostChat(namespace: Int32, id: Int64, enabled: Bool) {
+        guard (0...3).contains(namespace), id > 0 || (namespace == 3 && id != 0 && Int32(exactly: id) != nil) else { return }
+        var values = ghostChats
+        let key = peerKey(namespace: namespace, id: id)
+        if enabled { values.insert(key) } else { values.remove(key) }
+        defaults.set(values.sorted(), forKey: "faithgram.privacy.ghostChats")
+        NotificationCenter.default.post(name: FaithgramPreferences.changed, object: nil)
+    }
+    public static func suppressesRead(namespace: Int32, id: Int64) -> Bool {
+        return PatchClientPolicy.isEnabled(.blockCloudReads) || isGhostChat(namespace: namespace, id: id)
+    }
+    static func suppresses(_ description: FunctionDescription) -> Bool {
+        let methods: Set<String> = ["messages.setTyping", "messages.setEncryptedTyping", "messages.readHistory", "channels.readHistory", "messages.readMessageContents", "channels.readMessageContents", "messages.readDiscussion", "messages.readMentions", "messages.readReactions", "messages.readPollVotes", "messages.readEncryptedHistory", "stories.readStories", "stories.incrementStoryViews"]
+        guard methods.contains(description.name) else { return false }
+        for (name, parameter) in description.parameters where name == "peer" || name == "channel" {
+            guard let constructor = parameter.value as? TypeConstructorDescription else { continue }
+            let (type, fields) = constructor.descriptionFields()
+            let namespace: Int32
+            let field: String
+            if type.contains("User") { namespace = 0; field = "userId" }
+            else if type.contains("Channel") { namespace = 2; field = "channelId" }
+            else if type.contains("EncryptedChat") { namespace = 3; field = "chatId" }
+            else if type.contains("Chat") { namespace = 1; field = "chatId" }
+            else { continue }
+            if let value = fields.first(where: { $0.0 == field })?.1.value {
+                let id = (value as? Int64) ?? (value as? Int32).map(Int64.init)
+                if let id, isGhostChat(namespace: namespace, id: id) { return true }
+            }
+        }
+        return false
+    }
+}
diff --git a/submodules/TelegramCore/Sources/PatchClient/FaithgramProtocolLog.swift b/submodules/TelegramCore/Sources/PatchClient/FaithgramProtocolLog.swift
new file mode 100644
index 00000000..d0fd5662
--- /dev/null
+++ b/submodules/TelegramCore/Sources/PatchClient/FaithgramProtocolLog.swift
@@ -0,0 +1,96 @@
+import Foundation
+import TelegramApi
+
+public enum FaithgramProtocolLog {
+    private static let queue = DispatchQueue(label: "faithgram.protocol-log", qos: .utility)
+    private static let maximumBytes = 64 * 1024 * 1024
+    private static var cachedKey: Data?
+    public static var directory: URL {
+        return FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0]
+            .appendingPathComponent("Faithgram/ProtocolLogs", isDirectory: true)
+    }
+    public static func decoded(_ value: Any?) -> Any {
+        guard let value else { return NSNull() }
+        if let value = value as? ConstructorParameterDescription { return decoded(value.value) }
+        if let value = value as? TypeConstructorDescription {
+            let fields = value.descriptionFields()
+            var result: [String: Any] = ["_": fields.0]
+            for (key, field) in fields.1 { result[key] = decoded(field.value) }
+            return result
+        }
+        if let value = value as? FunctionDescription {
+            var result: [String: Any] = ["_": value.name]
+            for (key, field) in value.parameters { result[key] = decoded(field.value) }
+            return result
+        }
+        if let value = value as? Buffer { return ["bytes_base64": value.makeData().base64EncodedString()] }
+        if let value = value as? Data { return ["bytes_base64": value.base64EncodedString()] }
+        if let value = value as? String { return value }
+        if let value = value as? NSNumber { return value }
+        let mirror = Mirror(reflecting: value)
+        if mirror.displayStyle == .optional { return decoded(mirror.children.first?.value) }
+        if mirror.displayStyle == .collection { return mirror.children.map { decoded($0.value) } }
+        return String(describing: value)
+    }
+    @discardableResult
+    public static func begin(_ description: FunctionDescription, original: Buffer, effectivePayload: Data? = nil) -> UUID? {
+        guard PatchClientPolicy.isEnabled(.protocolLogger) else { return nil }
+        let id = UUID()
+        append(id: id, direction: "request", value: decoded(description), payload: effectivePayload ?? original.makeData())
+        return id
+    }
+    public static func finish(_ id: UUID?, result: Any) {
+        guard let id else { return }
+        append(id: id, direction: "response", value: decoded(result), payload: nil)
+    }
+    public static func fail(_ id: UUID?, code: Int, description: String) {
+        guard let id else { return }
+        append(id: id, direction: "error", value: ["code": code, "description": description], payload: nil)
+    }
+    private static func key() throws -> Data {
+        if let key = cachedKey { return key }
+        let key = try FaithgramVault.accountKey("protocol-log")
+        cachedKey = key
+        return key
+    }
+    private static func append(id: UUID, direction: String, value: Any, payload: Data?) {
+        let timestamp = Date().timeIntervalSince1970
+        queue.async {
+            do {
+                var event: [String: Any] = ["id": id.uuidString, "timestamp": timestamp, "direction": direction, "tl": value]
+                if let payload { event["wire_base64"] = payload.base64EncodedString() }
+                let data = try JSONSerialization.data(withJSONObject: event, options: [.sortedKeys])
+                let file = directory.appendingPathComponent(String(format: "%.6f", timestamp) + "-" + UUID().uuidString + ".fgl")
+                let encrypted = try FaithgramVault.seal(data, key: key(), context: "faithgram.protocol." + file.lastPathComponent)
+                try FaithgramVault.write(encrypted, to: file)
+                let files = try logFiles()
+                var total: Int = 0
+                for existingFile in files { total += try existingFile.resourceValues(forKeys: [.fileSizeKey]).fileSize ?? 0 }
+                for old in files where total > maximumBytes {
+                    if old == file { break }
+                    total -= try old.resourceValues(forKeys: [.fileSizeKey]).fileSize ?? 0
+                    try FileManager.default.removeItem(at: old)
+                }
+            } catch { FaithgramPreferences.setText("protocolLogError", "The protocol log could not be written.") }
+        }
+    }
+    private static func logFiles() throws -> [URL] {
+        guard FileManager.default.fileExists(atPath: directory.path) else { return [] }
+        return try FileManager.default.contentsOfDirectory(at: directory, includingPropertiesForKeys: [.fileSizeKey])
+            .filter { $0.pathExtension == "fgl" }.sorted { $0.lastPathComponent < $1.lastPathComponent }
+    }
+    public static func read(completion: @escaping (Result<String, Error>) -> Void) {
+        queue.async {
+            let result = Result<String, Error> {
+                let encryptionKey = try Self.key()
+                return try logFiles().map { file in
+                    let data = try FaithgramVault.open(Data(contentsOf: file), key: encryptionKey, context: "faithgram.protocol." + file.lastPathComponent)
+                    let object = try JSONSerialization.jsonObject(with: data)
+                    let pretty = try JSONSerialization.data(withJSONObject: object, options: [.prettyPrinted, .sortedKeys])
+                    return String(decoding: pretty, as: UTF8.self)
+                }.joined(separator: "\n\n")
+            }
+            DispatchQueue.main.async { completion(result) }
+        }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/PatchClient/FaithgramRichTranslation.swift b/submodules/TelegramCore/Sources/PatchClient/FaithgramRichTranslation.swift
new file mode 100644
index 00000000..786c0231
--- /dev/null
+++ b/submodules/TelegramCore/Sources/PatchClient/FaithgramRichTranslation.swift
@@ -0,0 +1,119 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+private func mapFaithgramRichText(_ text: RichText, cleanLinks: Bool = false, transform: (String) -> String) -> RichText {
+    func map(_ text: RichText) -> RichText { mapFaithgramRichText(text, cleanLinks: cleanLinks, transform: transform) }
+    switch text {
+    case let .plain(value): return .plain(transform(value))
+    case let .bold(value): return .bold(map(value))
+    case let .italic(value): return .italic(map(value))
+    case let .underline(value): return .underline(map(value))
+    case let .strikethrough(value): return .strikethrough(map(value))
+    case let .url(text, url, id): return .url(text: map(text), url: cleanLinks ? FaithgramLinkCleaner.cleanURL(url) : url, webpageId: id)
+    case let .concat(values): return .concat(values.map(map))
+    case let .subscript(value): return .subscript(map(value))
+    case let .superscript(value): return .superscript(map(value))
+    case let .marked(value): return .marked(map(value))
+    case let .anchor(value, name): return .anchor(text: map(value), name: name)
+    case let .textSpoiler(value): return .textSpoiler(text: map(value))
+    default: return text // Preserve code, formulas, usernames, URLs and structured identifiers.
+    }
+}
+
+private func mapFaithgramBlocks(_ blocks: [InstantPageBlock], cleanLinks: Bool = false, transform: (String) -> String) -> [InstantPageBlock] {
+    func text(_ value: RichText) -> RichText { mapFaithgramRichText(value, cleanLinks: cleanLinks, transform: transform) }
+    func children(_ value: [InstantPageBlock]) -> [InstantPageBlock] { mapFaithgramBlocks(value, cleanLinks: cleanLinks, transform: transform) }
+    func caption(_ value: InstantPageCaption) -> InstantPageCaption { InstantPageCaption(text: text(value.text), credit: cleanLinks ? text(value.credit) : value.credit) }
+    return blocks.map { block in
+        switch block {
+        case let .title(value): return .title(text(value))
+        case let .subtitle(value): return .subtitle(text(value))
+        case let .header(value): return .header(text(value))
+        case let .subheader(value): return .subheader(text(value))
+        case let .heading(value, level): return .heading(text: text(value), level: level)
+        case let .paragraph(value): return .paragraph(text(value))
+        case let .footer(value): return .footer(text(value))
+        case let .kicker(value): return .kicker(text(value))
+        case let .thinking(value): return .thinking(text(value))
+        case let .list(items, ordered):
+            return .list(items: items.map { item in
+                switch item {
+                case let .text(value, number, checked): return .text(text(value), number, checked)
+                case let .blocks(value, number, checked): return .blocks(children(value), number, checked)
+                case .unknown: return .unknown
+                }
+            }, ordered: ordered)
+        case let .blockQuote(blocks, value, collapsed): return .blockQuote(blocks: children(blocks), caption: text(value), collapsed: collapsed)
+        case let .pullQuote(value, label): return .pullQuote(text: text(value), caption: text(label))
+        case let .image(id, value, url, page, spoiler): return .image(id: id, caption: caption(value), url: cleanLinks ? url.map(FaithgramLinkCleaner.cleanURL) : url, webpageId: page, spoiler: spoiler)
+        case let .video(id, value, autoplay, loop, spoiler): return .video(id: id, caption: caption(value), autoplay: autoplay, loop: loop, spoiler: spoiler)
+        case let .audio(id, value): return .audio(id: id, caption: caption(value))
+        case let .cover(value): return .cover(children([value])[0])
+        case let .webEmbed(url, html, size, value, stretch, scrolling, cover): return .webEmbed(url: cleanLinks ? url.map(FaithgramLinkCleaner.cleanURL) : url, html: html, dimensions: size, caption: caption(value), stretchToWidth: stretch, allowScrolling: scrolling, coverId: cover)
+        case let .postEmbed(url, page, avatar, author, date, blocks, value): return .postEmbed(url: cleanLinks ? FaithgramLinkCleaner.cleanURL(url) : url, webpageId: page, avatarId: avatar, author: author, date: date, blocks: children(blocks), caption: caption(value))
+        case let .collage(items, value): return .collage(items: children(items), caption: caption(value))
+        case let .slideshow(items, value): return .slideshow(items: children(items), caption: caption(value))
+        case let .table(title, rows, bordered, striped):
+            return .table(title: text(title), rows: rows.map { row in
+                InstantPageTableRow(cells: row.cells.map { cell in
+                    InstantPageTableCell(text: cell.text.map(text), header: cell.header, alignment: cell.alignment, verticalAlignment: cell.verticalAlignment, colspan: cell.colspan, rowspan: cell.rowspan)
+                })
+            }, bordered: bordered, striped: striped)
+        case let .details(title, blocks, expanded): return .details(title: text(title), blocks: children(blocks), expanded: expanded)
+        case let .relatedArticles(title, articles): return .relatedArticles(title: text(title), articles: articles)
+        case let .map(latitude, longitude, zoom, dimensions, value): return .map(latitude: latitude, longitude: longitude, zoom: zoom, dimensions: dimensions, caption: caption(value))
+        default: return block
+        }
+    }
+}
+
+func faithgramCleanRichPage(_ page: InstantPage) -> InstantPage {
+    let blocks = mapFaithgramBlocks(page.blocks, cleanLinks: true) { FaithgramLinkCleaner.clean(NSAttributedString(string: $0)).string }
+    return InstantPage(blocks: blocks, media: page.media, isComplete: page.isComplete, rtl: page.rtl, url: page.url, views: page.views)
+}
+
+func faithgramTranslateRichMessages(account: Account, messageIds: [EngineMessage.Id], toLang: String) -> Signal<[EngineMessage.Id: InstantPage], TranslationError> {
+    guard let service = engineExperimentalInternalTranslationService else { return .fail(.generic) }
+    return account.postbox.transaction { transaction -> [(EngineMessage.Id, InstantPage)] in
+        return messageIds.compactMap { id in transaction.getMessage(id)?.richText.map { (id, $0.instantPage) } }
+    } |> castError(TranslationError.self)
+    |> mapToSignal { pages -> Signal<[(EngineMessage.Id, InstantPage)], TranslationError> in
+        let signals: [Signal<(EngineMessage.Id, InstantPage), TranslationError>] = pages.map { id, page in
+            var texts: [AnyHashable: String] = [:]
+            var index = 0
+            let _ = mapFaithgramBlocks(page.blocks) { value in
+                defer { index += 1 }
+                texts[AnyHashable(index)] = value
+                return value
+            }
+            if texts.isEmpty { return .single((id, page)) }
+            return service.translate(texts: texts, fromLang: "auto", toLang: toLang)
+            |> castError(TranslationError.self)
+            |> mapToSignal { result -> Signal<(EngineMessage.Id, InstantPage), TranslationError> in
+                guard let result else { return .fail(.generic) }
+                var index = 0
+                let blocks = mapFaithgramBlocks(page.blocks) { value in
+                    defer { index += 1 }
+                    return result[AnyHashable(index)] ?? value
+                }
+                return .single((id, InstantPage(blocks: blocks, media: page.media, isComplete: page.isComplete, rtl: ["ar", "fa", "he", "ur"].contains(toLang), url: page.url, views: page.views)))
+            }
+        }
+        return combineLatest(signals)
+    }
+    |> mapToSignal { pages -> Signal<[EngineMessage.Id: InstantPage], TranslationError> in
+        return account.postbox.transaction { transaction in
+            var result: [EngineMessage.Id: InstantPage] = [:]
+            for (id, page) in pages {
+                result[id] = page
+                transaction.updateMessage(id) { message in
+                    var attributes = message.attributes.filter { !($0 is TranslationMessageAttribute) }
+                    attributes.append(TranslationMessageAttribute(text: "", entities: [], toLang: toLang, instantPage: page))
+                    return .update(StoreMessage(id: message.id, customStableId: nil, globallyUniqueId: message.globallyUniqueId, groupingKey: message.groupingKey, threadId: message.threadId, timestamp: message.timestamp, flags: StoreMessageFlags(message.flags), tags: message.tags, globalTags: message.globalTags, localTags: message.localTags, forwardInfo: message.forwardInfo.flatMap(StoreMessageForwardInfo.init), authorId: message.author?.id, text: message.text, attributes: attributes, media: message.media))
+                }
+            }
+            return result
+        } |> castError(TranslationError.self)
+    }
+}
diff --git a/submodules/TelegramCore/Sources/PatchClient/FaithgramSessionBackup.swift b/submodules/TelegramCore/Sources/PatchClient/FaithgramSessionBackup.swift

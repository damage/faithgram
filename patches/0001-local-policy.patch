diff --git a/submodules/TelegramUI/Sources/FaithgramActivityManager.swift b/submodules/TelegramUI/Sources/FaithgramActivityManager.swift
new file mode 100644
index 0000000..ddff6c1
--- /dev/null
+++ b/submodules/TelegramUI/Sources/FaithgramActivityManager.swift
@@ -0,0 +1,57 @@
+import Foundation
+import UIKit
+import ActivityKit
+import FaithgramActivity
+import TelegramCore
+
+@available(iOS 16.2, *)
+final class FaithgramActivityManager {
+    static let shared = FaithgramActivityManager()
+    private var observer: NSObjectProtocol?
+    private var active = false
+    private var updating = false
+    private var pending = false
+    private init() {
+        observer = NotificationCenter.default.addObserver(forName: FaithgramPreferences.changed, object: nil, queue: .main) { [weak self] _ in self?.refresh() }
+    }
+    deinit { if let observer { NotificationCenter.default.removeObserver(observer) } }
+    func setActive(_ active: Bool) { self.active = active; refresh() }
+    private func refresh() {
+        if updating { pending = true; return }
+        let enabled = PatchClientPolicy.isEnabled(.dynamicIsland)
+        let active = self.active
+        let activities = Activity<FaithgramActivityAttributes>.activities
+        if !enabled {
+            updating = true
+            Task { @MainActor in
+                for activity in activities { await activity.end(nil, dismissalPolicy: .immediate) }
+                self.finished()
+            }
+            return
+        }
+        guard ActivityAuthorizationInfo().areActivitiesEnabled else {
+            FaithgramPreferences.setText("activityError", "Allow Live Activities in iOS settings to show Faithgram in Dynamic Island.")
+            return
+        }
+        let content = ActivityContent(state: FaithgramActivityAttributes.ContentState(active: active), staleDate: nil)
+        if let first = activities.first {
+            updating = true
+            Task { @MainActor in
+                await first.update(content)
+                for extra in activities.dropFirst() { await extra.end(nil, dismissalPolicy: .immediate) }
+                self.finished()
+            }
+        } else if active && UIApplication.shared.applicationState == .active {
+            do {
+                let _ = try Activity.request(attributes: FaithgramActivityAttributes(), content: content, pushType: nil)
+                FaithgramPreferences.setText("activityError", "")
+            } catch {
+                FaithgramPreferences.setText("activityError", "iOS could not start the Live Activity. Check signing and Live Activities permissions.")
+            }
+        }
+    }
+    private func finished() {
+        updating = false
+        if pending { pending = false; refresh() }
+    }
+}

diff --git a/submodules/TelegramUI/Sources/FaithgramActivityManager.swift b/submodules/TelegramUI/Sources/FaithgramActivityManager.swift
new file mode 100644
index 00000000..7eaaa9f1
--- /dev/null
+++ b/submodules/TelegramUI/Sources/FaithgramActivityManager.swift
@@ -0,0 +1,91 @@
+import Foundation
+import UIKit
+import ActivityKit
+import FaithgramActivity
+import TelegramCore
+
+@available(iOS 16.2, *)
+final class FaithgramActivityManager {
+    static let shared = FaithgramActivityManager()
+    private var observers: [NSObjectProtocol] = []
+    private var active = false
+    private var updating = false
+    private var pending = false
+    private var lastEnabled: Bool?
+    private var restartRequested = false
+
+    private init() {
+        active = UIApplication.shared.applicationState == .active
+        observers.append(NotificationCenter.default.addObserver(forName: FaithgramPreferences.changed, object: nil, queue: .main) { [weak self] _ in
+            guard let self, self.lastEnabled != PatchClientPolicy.isEnabled(.dynamicIsland) else { return }
+            self.refresh()
+        })
+        observers.append(NotificationCenter.default.addObserver(forName: FaithgramPreferences.restartLiveActivity, object: nil, queue: .main) { [weak self] _ in
+            guard let self else { return }
+            self.restartRequested = true
+            self.active = UIApplication.shared.applicationState == .active
+            self.refresh()
+        })
+    }
+    deinit { observers.forEach { NotificationCenter.default.removeObserver($0) } }
+    func setActive(_ active: Bool) { self.active = active; refresh() }
+    private func status(_ value: String, error: String = "") {
+        FaithgramPreferences.setText("activityStatus", value)
+        FaithgramPreferences.setText("activityError", error)
+    }
+    private var extensionInstalled: Bool {
+        guard let url = Bundle.main.builtInPlugInsURL,
+              let children = try? FileManager.default.contentsOfDirectory(at: url, includingPropertiesForKeys: nil) else { return false }
+        return children.contains { Bundle(url: $0)?.object(forInfoDictionaryKey: "CFBundleExecutable") as? String == "FaithgramActivityExtension" }
+    }
+    private func refresh() {
+        if updating { pending = true; return }
+        let enabled = PatchClientPolicy.isEnabled(.dynamicIsland)
+        lastEnabled = enabled
+        let activities = Activity<FaithgramActivityAttributes>.activities
+        if !enabled || restartRequested {
+            restartRequested = false
+            updating = true
+            if !enabled { status("off") }
+            else { pending = true; status("restarting") }
+            Task { @MainActor in
+                for activity in activities { await activity.end(nil, dismissalPolicy: .immediate) }
+                self.finished()
+            }
+            return
+        }
+        guard extensionInstalled else {
+            status("extension missing", error: "The Live Activity extension was removed while signing. Disable Remove app extensions in your signing tool, then sign and install the IPA again.")
+            return
+        }
+        guard ActivityAuthorizationInfo().areActivitiesEnabled else {
+            status("blocked by iOS", error: "Allow Live Activities for Faithgram in iOS Settings, then return to the app.")
+            return
+        }
+        let isForeground = UIApplication.shared.applicationState == .active
+        let content = ActivityContent(state: FaithgramActivityAttributes.ContentState(active: active || isForeground), staleDate: nil)
+        if let first = activities.first(where: { $0.activityState == .active || $0.activityState == .stale }) {
+            updating = true
+            Task { @MainActor in
+                await first.update(content)
+                for extra in activities where extra.id != first.id { await extra.end(nil, dismissalPolicy: .immediate) }
+                self.status("running · check Dynamic Island or the Lock Screen")
+                self.finished()
+            }
+        } else if isForeground {
+            do {
+                let _ = try Activity.request(attributes: FaithgramActivityAttributes(), content: content, pushType: nil)
+                status("running · check Dynamic Island or the Lock Screen")
+            } catch {
+                let failure = error as NSError
+                status("could not start", error: "\(failure.localizedDescription) (\(failure.domain): \(failure.code)). Check Live Activities permissions and the signed extension.")
+            }
+        } else {
+            status("waiting for the app to open")
+        }
+    }
+    private func finished() {
+        updating = false
+        if pending { pending = false; refresh() }
+    }
+}

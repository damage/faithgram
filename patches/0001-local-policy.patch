@@ -0,0 +1,37 @@
+import ActivityKit
+import WidgetKit
+import SwiftUI
+import FaithgramActivity
+
+@main
+struct FaithgramActivityWidgets: WidgetBundle {
+    var body: some Widget { FaithgramStatusWidget() }
+}
+
+struct FaithgramStatusWidget: Widget {
+    private func icon(_ size: CGFloat) -> some View {
+        Image("FaithgramIcon").resizable().scaledToFit().frame(width: size, height: size).accessibilityLabel("faithgram")
+    }
+    var body: some WidgetConfiguration {
+        ActivityConfiguration(for: FaithgramActivityAttributes.self) { context in
+            HStack(spacing: 14) {
+                icon(42)
+                VStack(alignment: .leading, spacing: 4) {
+                    Text("faithgram").font(.headline)
+                    Text(context.state.active ? "active" : "ready").font(.caption).foregroundColor(.gray)
+                }
+                Spacer()
+            }.padding(20).activityBackgroundTint(.black).activitySystemActionForegroundColor(.white).foregroundColor(.white)
+        } dynamicIsland: { context in
+            DynamicIsland {
+                DynamicIslandExpandedRegion(.leading) { icon(32) }
+                DynamicIslandExpandedRegion(.center) { Text("faithgram").font(.headline) }
+                DynamicIslandExpandedRegion(.trailing) { Circle().fill(context.state.active ? Color.white : Color.gray).frame(width: 8, height: 8) }
+                DynamicIslandExpandedRegion(.bottom) { Text(context.state.active ? "active" : "ready").font(.caption).foregroundColor(.gray) }
+            } compactLeading: { icon(20) }
+              compactTrailing: { Text("faithgram").font(.system(size: 13, weight: .semibold)).lineLimit(1) }
+              minimal: { icon(20) }
+            .keylineTint(.white)
+        }
+    }
+}

@@ -0,0 +1,51 @@
+import Foundation
+import UIKit
+import TelegramCore
+import TelegramPresentationData
+import ContextUI
+
+/// Removes message context-menu entries the user switched off in Faithgram settings.
+enum FaithgramContextMenu {
+    static func disabledMessageTitles(_ strings: PresentationStrings) -> Set<String> {
+        var result = Set<String>()
+        func off(_ option: PatchClientOption, _ titles: [String]) {
+            if !PatchClientPolicy.isEnabled(option) { titles.forEach { result.insert($0) } }
+        }
+        off(.contextMenuReply, [strings.Conversation_ContextMenuReply])
+        off(.contextMenuEdit, [strings.Conversation_MessageDialogEdit])
+        off(.contextMenuCopy, [strings.Conversation_ContextMenuCopy])
+        off(.contextMenuCopyLink, [strings.Conversation_ContextMenuCopyLink])
+        off(.contextMenuForward, [strings.Conversation_ContextMenuForward])
+        off(.contextMenuPin, [strings.Conversation_Pin, strings.Conversation_Unpin])
+        off(.contextMenuSelect, [strings.Conversation_ContextMenuSelect])
+        off(.contextMenuTranslate, [strings.Conversation_ContextMenuTranslate])
+        off(.contextMenuSpeak, [strings.Conversation_ContextMenuSpeak])
+        off(.contextMenuReport, [strings.Conversation_ContextMenuReport])
+        off(.contextMenuDelete, [strings.Conversation_ContextMenuDelete])
+        off(.contextMenuSaveMedia, [strings.Gallery_SaveImage, strings.Gallery_SaveVideo, strings.Conversation_SaveToFiles])
+        off(.contextMenuGhost, ["Enable Ghost for this chat", "Disable Ghost for this chat"].map(FaithgramPreferences.interfaceText))
+        off(.contextMenuHistory, [FaithgramPreferences.interfaceText("Message history")])
+        off(.contextMenuMediaArchive, ["Enable media archive for this chat", "Disable media archive for this chat"].map(FaithgramPreferences.interfaceText))
+        return result
+    }
+
+    static func filterMessageMenu(_ items: [ContextMenuItem], strings: PresentationStrings) -> [ContextMenuItem] {
+        return filter(items, disabled: disabledMessageTitles(strings))
+    }
+
+    /// Drops disabled actions and collapses the separators left behind.
+    static func filter(_ items: [ContextMenuItem], disabled: Set<String>) -> [ContextMenuItem] {
+        guard !disabled.isEmpty else { return items }
+        var result: [ContextMenuItem] = []
+        for item in items {
+            if case let .action(action) = item, disabled.contains(action.text) { continue }
+            if case .separator = item {
+                if result.isEmpty { continue }
+                if let last = result.last, case .separator = last { continue }
+            }
+            result.append(item)
+        }
+        if let last = result.last, case .separator = last { result.removeLast() }
+        return result
+    }
+}

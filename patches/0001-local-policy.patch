+++ b/submodules/TelegramUI/Sources/FaithgramMessageShot.swift
@@ -0,0 +1,62 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ChatMessageItemView
+import UndoUI
+
+extension ChatControllerImpl {
+    /// "Shot": renders the selected messages that are currently on screen into one image and copies it.
+    func faithgramShotSelectedMessages() {
+        guard let selectedIds = self.presentationInterfaceState.interfaceState.selectionState?.selectedIds, !selectedIds.isEmpty else { return }
+        self.commitPurposefulAction()
+        // Leave selection mode first so checkmarks and the selection offset are not part of the picture.
+        self.updateChatPresentationInterfaceState(animated: false, interactive: true, { $0.updatedInterfaceState({ $0.withoutSelectionState() }) })
+        let presentationData = self.presentationData
+        Queue.mainQueue().after(0.12) { [weak self] in
+            guard let self else { return }
+            var captures: [(index: EngineMessage.Index, image: UIImage)] = []
+            self.chatDisplayNode.historyNode.forEachVisibleMessageItemNode { itemNode in
+                guard let item = itemNode.item else { return }
+                let ids: [EngineMessage.Id]
+                switch item.content {
+                case let .message(message, _, _, _, _): ids = [message.id]
+                case let .group(messages): ids = messages.map { $0.0.id }
+                }
+                guard ids.contains(where: { selectedIds.contains($0) }) else { return }
+                let size = itemNode.bounds.size
+                guard size.width > 1.0, size.height > 1.0 else { return }
+                let image = UIGraphicsImageRenderer(size: size).image { context in
+                    itemNode.layer.render(in: context.cgContext)
+                }
+                captures.append((item.content.firstMessage.index, image))
+            }
+            guard !captures.isEmpty else {
+                self.faithgramShowNotice(presentationData.strings.Conversation_ErrorInaccessibleMessage, presentationData: presentationData)
+                return
+            }
+            captures.sort { $0.index < $1.index }
+            let padding: CGFloat = 8.0
+            let width = (captures.map { $0.image.size.width }.max() ?? 0.0) + padding * 2.0
+            let height = captures.reduce(padding * 2.0) { $0 + $1.image.size.height }
+            let background = presentationData.theme.list.plainBackgroundColor
+            let composed = UIGraphicsImageRenderer(size: CGSize(width: width, height: height)).image { context in
+                background.setFill()
+                context.fill(CGRect(origin: .zero, size: CGSize(width: width, height: height)))
+                var y = padding
+                for capture in captures {
+                    capture.image.draw(at: CGPoint(x: padding, y: y))
+                    y += capture.image.size.height
+                }
+            }
+            UIPasteboard.general.image = composed
+            self.faithgramShowNotice(FaithgramPreferences.interfaceText("Shot copied to the clipboard."), presentationData: presentationData)
+        }
+    }
+
+    private func faithgramShowNotice(_ text: String, presentationData: PresentationData) {
+        self.present(UndoOverlayController(presentationData: presentationData, content: .copy(text: text), elevatedLayout: false, animateInAsReplacement: false, action: { _ in return false }), in: .current)
+    }
+}

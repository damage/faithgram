+                item.accessibilityLabel = FaithgramPreferences.interfaceText(label)
+                items.append(item)
+                items.append(UIBarButtonItem(barButtonSystemItem: .flexibleSpace, target: nil, action: nil))
+            }
+        }
+        if translation {

+/// Applies the context-menu switches to the sticker peek menu and adds the copy-id entry.
+private func faithgramStickerMenu(_ items: [ContextMenuItem], context: AccountContext, strings: PresentationStrings, file: TelegramMediaFile, present: @escaping (ViewController) -> Void) -> [ContextMenuItem] {
+    var result: [ContextMenuItem] = items
+    var disabled: Set<String> = []
+    if !PatchClientPolicy.isEnabled(.contextMenuSendSilently) { disabled.insert(strings.Conversation_SendMessage_SendSilently) }
+    if !PatchClientPolicy.isEnabled(.contextMenuSchedule) { disabled.insert(strings.Conversation_SendMessage_ScheduleMessage) }
+    if !PatchClientPolicy.isEnabled(.contextMenuFavorites) { disabled.insert(strings.Stickers_AddToFavorites); disabled.insert(strings.Stickers_RemoveFromFavorites) }
+    if !PatchClientPolicy.isEnabled(.contextMenuEditSticker) { disabled.insert(strings.Stickers_EditSticker) }
+    if !PatchClientPolicy.isEnabled(.contextMenuStickerSet) { disabled.insert(strings.StickerPack_ViewPack) }
+    if !PatchClientPolicy.isEnabled(.contextMenuRemoveRecent) { disabled.insert(strings.Stickers_RemoveFromRecent) }
+    if !disabled.isEmpty {
+        result = result.filter { (item: ContextMenuItem) -> Bool in
+            if case let .action(action) = item { return !disabled.contains(action.text) }
+            return true
+        }
+    }
+    if PatchClientPolicy.isEnabled(.contextMenuCopyStickerId) {
+        let stickerId: String = String(file.fileId.id)
+        let copyItem = ContextMenuActionItem(text: FaithgramPreferences.interfaceText("Copy sticker id"), icon: { (theme: PresentationTheme) -> UIImage? in
+            return UIImage(systemName: "doc.on.doc")?.withTintColor(theme.contextMenu.primaryColor, renderingMode: .alwaysOriginal)
+        }, action: { _, f in
+            UIPasteboard.general.string = stickerId
+            let presentationData: PresentationData = context.sharedContext.currentPresentationData.with { $0 }
+            present(UndoOverlayController(presentationData: presentationData, content: .copy(text: FaithgramPreferences.interfaceText("Sticker id copied.")), elevatedLayout: false, action: { _ in return false }))
+            f(.default)
+        })
+        result.append(.action(copyItem))
+    }
+    return result
+}

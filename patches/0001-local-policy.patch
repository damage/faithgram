@@ -0,0 +1,77 @@
+import Foundation
+import UIKit
+import TelegramCore
+
+final class FaithgramPrivacyUI: NSObject, UIGestureRecognizerDelegate {
+    static let shared = FaithgramPrivacyUI()
+    private weak var window: UIWindow?
+    private var cover: UIView?
+    private var recognizers: [UISwipeGestureRecognizer] = []
+    private var action: ((String) -> Void)?
+    private var observer: NSObjectProtocol?
+    private override init() {
+        super.init()
+        observer = NotificationCenter.default.addObserver(forName: FaithgramPreferences.changed, object: nil, queue: .main) { [weak self] _ in
+            guard let self else { return }
+            if UIApplication.shared.applicationState != .active { self.hidePreview(window: self.window) }
+            UIApplication.shared.shortcutItems = Self.shortcutItems(existing: UIApplication.shared.shortcutItems ?? [])
+        }
+    }
+    deinit { if let observer { NotificationCenter.default.removeObserver(observer) } }
+    static func shortcutItems(existing: [UIApplicationShortcutItem]) -> [UIApplicationShortcutItem] {
+        let original = existing.filter { !$0.type.hasPrefix("faithgram.") }
+        guard PatchClientPolicy.isEnabled(.customGestures) else { return original }
+        let items = [UIApplicationShortcutItem(type: "faithgram.profiles", localizedTitle: FaithgramPreferences.interfaceText("Privacy profiles"), localizedSubtitle: nil, icon: UIApplicationShortcutIcon(type: .task), userInfo: nil), UIApplicationShortcutItem(type: "faithgram.ghost", localizedTitle: FaithgramPreferences.interfaceText("Toggle Ghost mode"), localizedSubtitle: nil, icon: UIApplicationShortcutIcon(type: .prohibit), userInfo: nil)]
+        return Array((items + original).prefix(4))
+    }
+    func configure(window: UIWindow?, action: @escaping (String) -> Void) {
+        self.action = action
+        if self.window !== window {
+            if let previous = self.window { recognizers.forEach { previous.removeGestureRecognizer($0) } }
+            self.window = window
+            recognizers = []
+            let directions: [UISwipeGestureRecognizer.Direction] = [.up, .down]
+            for direction in directions {
+                let recognizer = UISwipeGestureRecognizer(target: self, action: #selector(swiped(_:)))
+                recognizer.direction = direction
+                recognizer.numberOfTouchesRequired = 3
+                recognizer.cancelsTouchesInView = false
+                recognizer.delegate = self
+                window?.addGestureRecognizer(recognizer)
+                recognizers.append(recognizer)
+            }
+        }
+        showPreview()
+    }
+    func hidePreview(window: UIWindow?) {
+        guard PatchClientPolicy.isEnabled(.hideAppPreview), let window else { showPreview(); return }
+        if let cover { window.bringSubviewToFront(cover); return }
+        let view = UIView(frame: window.bounds)
+        view.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        view.backgroundColor = .black
+        let icon = UIImageView(image: Bundle.main.path(forResource: "FaithgramIcon", ofType: "png").flatMap { UIImage(contentsOfFile: $0) })
+        icon.frame = CGRect(x: (view.bounds.width - 72) / 2, y: (view.bounds.height - 72) / 2, width: 72, height: 72)
+        icon.autoresizingMask = [.flexibleLeftMargin, .flexibleRightMargin, .flexibleTopMargin, .flexibleBottomMargin]
+        view.addSubview(icon)
+        window.addSubview(view)
+        cover = view
+    }
+    func showPreview() { cover?.removeFromSuperview(); cover = nil }
+    func gestureRecognizer(_ gestureRecognizer: UIGestureRecognizer, shouldReceive touch: UITouch) -> Bool {
+        guard PatchClientPolicy.isEnabled(.customGestures), UIApplication.shared.applicationState == .active else { return false }
+        var target = touch.view
+        while let view = target {
+            if view is UITextInput { return false }
+            target = view.superview
+        }
+        return true
+    }
+    func gestureRecognizer(_ gestureRecognizer: UIGestureRecognizer, shouldRecognizeSimultaneouslyWith otherGestureRecognizer: UIGestureRecognizer) -> Bool { return true }
+    @objc private func swiped(_ recognizer: UISwipeGestureRecognizer) {
+        guard recognizer.state == .ended, PatchClientPolicy.isEnabled(.customGestures) else { return }
+        let direction = recognizer.direction == .up ? "up" : "down"
+        let fallback = direction == "up" ? "profiles" : "ghost"
+        let value = FaithgramPreferences.text("gesture." + direction, fallback: fallback)
+        if value != "none" { action?(value) }
+    }
+}

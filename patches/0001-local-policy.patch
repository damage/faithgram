+static NSString * _Nonnull faithgramInterfaceTemplate(NSString * _Nonnull value) {
+    if (![[NSUserDefaults standardUserDefaults] boolForKey:@"patchclient.option.lowercaseInterface"]) {
+        return value;
+    }
+    static NSRegularExpression *protectedTokens;
+    static dispatch_once_t token;
+    dispatch_once(&token, ^{
+        protectedTokens = [NSRegularExpression regularExpressionWithPattern:@"https?://[^[:space:]]+|tg://[^[:space:]]+|%[0-9$]*[@d]" options:NSRegularExpressionCaseInsensitive error:nil];
+    });
+    NSMutableString *result = [[NSMutableString alloc] init];
+    NSUInteger offset = 0;
+    for (NSTextCheckingResult *match in [protectedTokens matchesInString:value options:0 range:NSMakeRange(0, value.length)]) {
+        [result appendString:[[value substringWithRange:NSMakeRange(offset, match.range.location - offset)] lowercaseString]];
+        [result appendString:[value substringWithRange:match.range]];
+        offset = NSMaxRange(match.range);
+    }
+    [result appendString:[[value substringFromIndex:offset] lowercaseString]];
+    return result;
+}
+
